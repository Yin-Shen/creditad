# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
*.egg-info/
.eggs/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
build/
dist/

# ── Data (see DATA_POLICY.md) ──────────────────────────
# Tier 1 SHIPS and is force-added below; everything large stays out.
*.mcool
*.cool
*.hic
*.bam
*.bai
*.fa
*.fasta
*.fai
*.2bit
*.npz
*.h5
*.hdf5
# Raw uncompressed tables: the repo ships the .gz forms only.
data/multicell/*/annotation.tsv
data/multicell/*/*_boundaries.bed
data/loops/*.bedpe
# Local download directories for tier-2 inputs
data/raw/
data/encode/

# The synthetic 416 kB CI fixture is re-included: it is generated by
# backend/tests/builtin_callers/_make_toy_mcool.py with a fixed seed, twelve
# tests read it, and without it `pytest` fails in a fresh clone (12 failures)
# even though it passes in the build tree. Real contact matrices stay excluded
# by the rule above.
!backend/tests/builtin_callers/toy_8mb.mcool

# Tier-1 content that MUST be tracked (negations must follow the rules above)
!data/multicell/*/annotation.tsv.gz
!data/multicell/*/*_boundaries.bed.gz
!data/multicell/*/manifest.json
!data/loops/*.bedpe.gz
!data/chr7_preview_tracks/*.bigWig
!data/chr7_preview_tracks/README.md

# ── Local run outputs ──────────────────────────────────
reproduce_out/
creditad_results/
*.log

# ── Backups / scratch ──────────────────────────────────
*.bak
*.bak_*
*.pre_*
*.orig
*.tmp
*.disabled

# ── OS / editor ────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
